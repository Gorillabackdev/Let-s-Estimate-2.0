# GEMINI_API_KEY: Required for Google Gemini 2.5 Flash Vision AI drawing takeoff.
# AI Studio automatically injects this at runtime from user secrets.
# For local development outside AI Studio, obtain a key from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SMTP Email Delivery (Optional: provide SMTP to dispatch live verification & reset emails)
# If not configured, verification PIN codes are logged and shown on-screen for instant testing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Let'\''s Estimate" <no-reply@letsestimate.com>'
