# GEMINI_API_KEY: Required for Google Gemini 2.5 Flash Vision AI drawing takeoff.
# AI Studio automatically injects this at runtime from user secrets.
# For local development outside AI Studio, obtain a key from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
